# Database: leave unset to use the default (backend/medstock.db, cwd-independent).
# To override, use an absolute path, e.g. sqlite:///C:/absolute/path/medstock.db
# DATABASE_URL=sqlite:///./medstock.db

JWT_SECRET_KEY=change_this_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Any OpenAI-compatible endpoint serving Qwen. Leave QWEN_API_KEY empty to use
# the built-in offline stub responses. Examples:
#   Alibaba Model Studio: https://dashscope-intl.aliyuncs.com/compatible-mode/v1  (model qwen-plus)
#   Ollama (local, free):  http://localhost:11434/v1                              (model qwen3)
#   OpenRouter:            https://openrouter.ai/api/v1                           (model qwen/qwen3-235b-a22b)
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen-plus

UPLOAD_MAX_SIZE_MB=20
EMERGENCY_PURCHASE_PREMIUM=1.35

CORS_ORIGINS=http://localhost:3000,http://localhost:5173
