# Local dev artifacts — never needed inside the image
.venv/
**/node_modules/
**/dist/
**/__pycache__/
**/.pytest_cache/
*.pyc

# Secrets and local database — real values come from HF Space Secrets instead
backend/.env
frontend/.env
backend/*.db
backend/*.db-wal
backend/*.db-shm

# Version control and editor noise
.git/
.gitignore
.vscode/
.idea/
.qoder/

# Local-only deliverables, not part of the running app
*.pptx
*.docx
*.pdf
