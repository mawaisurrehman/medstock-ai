# --- Secrets: real values stay local; .env.example is the tracked template ---
.env
.env.local
*.env.local

# --- Python ---
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Database (seeded at first run; -wal/-shm are SQLite sidecars) ---
*.db
*.db-wal
*.db-shm

# --- Node / frontend ---
node_modules/
dist/
.vite/

# --- Docker / Hugging Face deployment: kept locally for pushing to the HF
# Space's own git remote, deliberately not part of this GitHub repo. ---
Dockerfile
.dockerignore
backend/static/

# --- Presentation / export artifacts (kept local, not published) ---
*.pptx
*.ppt
*.pdf

# --- Editors, OS, Office lock files ---
.vscode/
.idea/
.qoder/
.DS_Store
Thumbs.db
~$*
